  <parameter name="mensaje" class="java.lang.String"><defaultValueExpression><![CDATA["¡Gracias por tu compra!"]]></defaultValueExpression></parameter>
  <field name="nombre" class="java.lang.String"/>
  <field name="precio" class="java.lang.String"/>
  <title><band height="109" splitType="Prevent">
    <textField isStretchWithOverflow="true"><reportElement x="6" y="8" width="139" height="28"/><textElement textAlignment="Center"><font size="12" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{empresa}]]></textFieldExpression></textField>
    <textField isStretchWithOverflow="true"><reportElement positionType="Float" x="6" y="40" width="139" height="12"/><textElement textAlignment="Center"><font size="7"/></textElement><textFieldExpression><![CDATA[$P{direccion}]]></textFieldExpression></textField>
