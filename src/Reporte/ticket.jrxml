    <textField pattern="dd/MM/yyyy  HH:mm"><reportElement positionType="Float" x="6" y="89" width="139" height="13"/><textElement textAlignment="Center"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{fecha}]]></textFieldExpression></textField>
  </band></title>
  <columnHeader><band height="24">
