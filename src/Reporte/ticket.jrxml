<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TicketVenta" language="java" pageWidth="151" pageHeight="612" columnWidth="151" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
  <style name="Ticket" isDefault="true" fontName="SansSerif" fontSize="8" forecolor="#000000"/>
  <parameter name="total" class="java.lang.String" isForPrompting="false"/>
